{
  "name": "com.switchbot.controller.sdplugin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Doya",
  "description": "Stream Deck plugin for controlling SwitchBot devices, scenes, and sensors (unofficial, not affiliated with SwitchBot).",
  "repository": {
    "type": "git",
    "url": "https://github.com/DOYA09/switchbot-controller.git"
  },
  "homepage": "https://github.com/DOYA09/switchbot-controller#readme",
  "bugs": {
    "url": "https://github.com/DOYA09/switchbot-controller/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "package": "streamdeck pack com.switchbot.controller.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "^1.3.0",
    "@eslint/js": "^9.9.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "rollup": "^4.18.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0"
  }
}
